{
    "name": "netglue/prismic-repo-clone",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "george@net-glue.co.uk"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.4.99"
        }
    },
    "require": {
        "php": "~8.4",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "azjezz/psl": "^3.2",
        "cuyz/valinor": "^1.14",
        "fig/http-message-util": "^1.1",
        "gsteel/dot": "^1.8",
        "laminas/laminas-config-aggregator": "^1.17",
        "laminas/laminas-diactoros": "^3.5",
        "laminas/laminas-servicemanager": "^4.4",
        "league/mime-type-detection": "^1.16",
        "netglue/prismic-asset-api-client": "^1.0",
        "netglue/prismic-cli": "^1.10",
        "netglue/prismic-client": "^1.13",
        "netglue/prismic-doctype-client": "^1.7",
        "netglue/prismic-migration-client": "^1.0.x-dev",
        "php-http/curl-client": "^2.3",
        "psr/container": "^1 || ^2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "bnf/phpstan-psr-container": "^1.1",
        "doctrine/coding-standard": "^12.0",
        "php-standard-library/phpstan-extension": "^2.0",
        "php-standard-library/psalm-plugin": "^2.3.0",
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.1.5",
        "phpstan/phpstan-phpunit": "^2.0.4",
        "phpstan/phpstan-strict-rules": "^2.0.3",
        "phpunit/phpunit": "^12.0.2",
        "psalm/plugin-phpunit": "^0.19.2",
        "squizlabs/php_codesniffer": "^3.11.3",
        "vimeo/psalm": "^6.6.1"
    },
    "provide": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*"
    },
    "autoload": {
        "psr-4": {
            "Prismic\\Cloner\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\Unit\\": "test/Unit",
            "App\\Test\\Integration\\": "test/Integration"
        },
        "files": [
            "vendor/cuyz/valinor/qa/Psalm/ValinorPsalmPlugin.php"
        ]
    }
}
